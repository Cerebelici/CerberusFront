# ------------------------------------------------------------------
# Cerberus frontend configuration
# Copy to `.env` (git-ignored) and adjust. Vite reads these at startup,
# so restart `npm run dev` after editing.
# ------------------------------------------------------------------

# --- Dev server (read by vite.config.ts only, NOT exposed to the browser) ---
# Backend that the Vite dev/preview server proxies `/api/*` requests to.
DEV_PROXY_TARGET=http://localhost:8080
# Host/port the Vite dev server listens on.
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=5173

# --- Browser runtime (exposed to the client bundle via import.meta.env) ---
# Base URL prepended to every `/api/...` call. Leave EMPTY to use same-origin
# requests through the Vite proxy above (recommended for local development).
# Set to e.g. http://localhost:8080 only when serving the built app without a proxy
# (the backend already sends `Access-Control-Allow-Origin: *`).
VITE_API_BASE_URL=
# Optional. Sent as `X-API-Key` on every request. Must match CERBERUS_API_KEY on the
# backend. Only needed when the browser reaches the backend from a non-loopback address.
# WARNING: anything prefixed VITE_ is embedded in the built JS bundle.
VITE_API_KEY=
# Per-request timeout for API calls (milliseconds).
VITE_API_TIMEOUT_MS=10000
# How often the side nav / dashboard refresh GET /api/status when idle (ms).
VITE_STATUS_POLL_INTERVAL_MS=30000
# Faster polling cadence used while a scan is running (ms).
VITE_SCAN_POLL_INTERVAL_MS=3000
# How long the UI keeps watching a triggered scan before giving up (ms). Default 15 min,
# matching the backend's CERBERUS_SCAN_TIMEOUT default.
VITE_SCAN_WATCH_TIMEOUT_MS=900000
# Number of rows requested from GET /api/scans for the scan history table.
VITE_SCAN_HISTORY_LIMIT=50
